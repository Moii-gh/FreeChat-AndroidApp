<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#5AFFFFFF"
                android:startColor="#84FFFFFF" />
            <stroke android:width="1dp" android:color="#C8FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#36FFFFFF"
                android:startColor="#62FFFFFF" />
            <stroke android:width="1dp" android:color="#9EFFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
