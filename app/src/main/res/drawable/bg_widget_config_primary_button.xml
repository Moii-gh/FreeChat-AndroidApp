<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#6097E4FF"
                android:startColor="#82FFFFFF" />
            <stroke android:width="1dp" android:color="#C8FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#4E8BD9FF"
                android:startColor="#70FFFFFF" />
            <stroke android:width="1dp" android:color="#A8FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
