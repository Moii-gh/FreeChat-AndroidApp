<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#52FFFFFF"
                android:startColor="#76FFFFFF" />
            <stroke android:width="1dp" android:color="#B8FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#28FFFFFF"
                android:startColor="#46FFFFFF" />
            <stroke android:width="1dp" android:color="#86FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
