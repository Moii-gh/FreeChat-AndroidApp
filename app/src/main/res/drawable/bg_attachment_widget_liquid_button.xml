<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#4AFFFFFF"
                android:startColor="#70FFFFFF" />
            <stroke android:width="1dp" android:color="#B0FFFFFF" />
            <corners android:radius="@dimen/attachment_widget_button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#22FFFFFF"
                android:startColor="#3FFFFFFF" />
            <stroke android:width="1dp" android:color="#78FFFFFF" />
            <corners android:radius="@dimen/attachment_widget_button_radius" />
        </shape>
    </item>
</selector>
