<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/tvWidgetCornerRadiusLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_config_corner_radius"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetCornerRadiusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8B1BE"
            android:textSize="13sp" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/widgetCornerRadiusSeekBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:splitTrack="false"
        android:progressDrawable="@drawable/slider_progress_drawable"
        android:thumb="@drawable/slider_thumb"
        android:thumbOffset="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />
</LinearLayout>
