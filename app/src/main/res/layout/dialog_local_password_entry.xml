<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:id="@+id/entryDialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_security_card"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/ivLockIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_security"
            app:tint="@color/security_text_primary" />

        <TextView
            android:id="@+id/tvEntryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/security_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEntryError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#D86A6A"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Password input container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_security_input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/etEntryPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:textColorHint="@color/security_text_muted"
                android:textColor="@color/security_text_primary"
                android:textSize="15sp"
                android:inputType="textPassword"
                android:maxLines="1"
                android:imeOptions="actionDone" />

            <ImageButton
                android:id="@+id/btnToggleEntryPassword"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_security_text_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="center"
                android:src="@drawable/ic_security_eye_off" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Fingerprint trigger button, only shown if biometric is available -->
            <ImageButton
                android:id="@+id/btnEntryFingerprint"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_delete_link_cancel_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_security_fingerprint"
                app:tint="@color/security_text_primary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnEntryUnlock"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_security_confirm_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
