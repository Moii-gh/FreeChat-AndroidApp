<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="72dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="6dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center_horizontal">

        <!-- Circular App Icon Card centered inside FrameLayout -->
        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|start"
            app:cardBackgroundColor="#1C1C1E"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivSelectedAppIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>

        <!-- Small circular cross overlay in the top-right -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnRemoveSelectedApp"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            app:cardBackgroundColor="#E0E0E0"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:src="@drawable/ic_assistant_close"
                app:tint="#1C1C1E"
                android:contentDescription="@null" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <TextView
        android:id="@+id/tvSelectedAppLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
