<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_outline"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/smart_notifications_whitelist_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_outline"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF"
            android:contentDescription="@null" />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/toolbar"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/search_bar_bg">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:drawableTint="#8E8E93"
            android:hint="@string/smart_notifications_whitelist_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="15sp"
            android:maxLines="1" />
    </FrameLayout>

    <!-- Scroll-Responsive Selected Apps Header -->
    <FrameLayout
        android:id="@+id/selectedAppsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchContainer"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:layout_centerHorizontal="true"
        android:background="@drawable/bg_assistant_card"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <!-- Expanded View: Horizontal scrollable icon + title vertical items -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedApps"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:visibility="visible" />

        <!-- Collapsed View: Pill inside a Pill + 7 Recent Icons -->
        <LinearLayout
            android:id="@+id/layoutCollapsedHeader"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <!-- Inner Pill (Pill inside a Pill) -->
            <TextView
                android:id="@+id/tvSelectedCountPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textColor="#1C1C1E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Elegant gap of 8dp -->
            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Clear All Whitelist Button (cross in circle outline) -->
            <ImageView
                android:id="@+id/btnClearAllWhitelist"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_outline"
                android:padding="6dp"
                android:src="@drawable/ic_assistant_close"
                app:tint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@null" />

            <!-- Spacer to push recent icons to the far right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Overlapping Recent Icons Container -->
            <LinearLayout
                android:id="@+id/layoutRecentIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent4"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent6"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent6"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRecent7"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-8dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/ivRecent7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminateTint="#FFFFFF"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/smart_notifications_whitelist_empty"
        android:textColor="#8E8E93"
        android:textSize="16sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppsList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/selectedAppsHeader"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:clipToPadding="false" />

</RelativeLayout>
