<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_config_screen"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_outline"
            android:clickable="true"
            android:contentDescription="@string/content_desc_back"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/widget_config_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_outline"
            android:clickable="true"
            android:contentDescription="@string/button_save"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tvWidgetConfigDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_description"
                android:textColor="#A8B1BE"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/widgetConfigPreviewPanel"
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_attachment_widget_liquid_panel_medium"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/widgetConfigPreviewBackgroundImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <View
                    android:id="@+id/widgetConfigPreviewBackgroundScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="18dp">

                    <LinearLayout
                        android:id="@+id/widgetConfigPreviewInput"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/attachment_widget_input_height"
                        android:background="@drawable/bg_attachment_widget_liquid_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:id="@+id/widgetConfigPreviewLogo"
                            android:layout_width="@dimen/attachment_widget_logo_size"
                            android:layout_height="@dimen/attachment_widget_logo_size"
                            android:alpha="0.72"
                            android:contentDescription="@string/app_brand"
                            android:scaleType="fitCenter"
                            android:src="@drawable/freechat_logo_white_transparent" />

                        <TextView
                            android:id="@+id/widgetConfigPreviewPlaceholder"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/main_panel_input"
                            android:textColor="#F8FBFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widgetConfigPreviewCamera"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_attachment_widget_liquid_button"
                            android:contentDescription="@string/button_camera"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_camera_new"
                            android:tint="#FFFFFF" />

                        <ImageView
                            android:id="@+id/widgetConfigPreviewGallery"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_attachment_widget_liquid_button"
                            android:contentDescription="@string/content_desc_open_gallery"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_photo_new"
                            android:tint="#FFFFFF" />

                        <ImageView
                            android:id="@+id/widgetConfigPreviewDocument"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_attachment_widget_liquid_button"
                            android:contentDescription="@string/button_files"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_file_new"
                            android:tint="#FFFFFF" />

                        <ImageView
                            android:id="@+id/widgetConfigPreviewMic"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_attachment_widget_liquid_button"
                            android:contentDescription="@string/content_desc_microphone"
                            android:padding="11dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_mic"
                            android:tint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/widgetStyleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_style_section"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widgetStyleLiquidGlass"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_widget_config_option_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/widget_style_liquid_glass"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widgetStyleDark"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_widget_config_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/widget_style_dark"
                        android:textColor="#A8B1BE"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widgetStyleAdaptive"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_widget_config_option"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/widget_style_adaptive"
                        android:textColor="#A8B1BE"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetManualSettingsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_manual_settings"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <include layout="@layout/widget_config_slider_transparency" />
                <include layout="@layout/widget_config_slider_corner_radius" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
