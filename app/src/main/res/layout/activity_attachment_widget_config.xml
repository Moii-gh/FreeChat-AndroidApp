<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_config_screen"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:clickable="true"
            android:contentDescription="@string/content_desc_back"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/widget_config_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSave"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_toolbar_button"
            android:clickable="true"
            android:contentDescription="@string/button_save"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_check"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tvWidgetConfigDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_config_description"
                android:textColor="#A8B1BE"
                android:textSize="14sp" />

            <!-- Modern Wallpaper container for realistic transparent widget preview -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_preview_container_wallpaper"
                android:clipToOutline="true"
                android:padding="23dp">

                <FrameLayout
                    android:id="@+id/widgetConfigPreviewPanel"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_attachment_widget_liquid_panel_medium"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/widgetConfigPreviewBackgroundImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <View
                        android:id="@+id/widgetConfigPreviewBackgroundScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    <!-- 2x4 Layout (Default Tall Large) -->
                    <LinearLayout
                        android:id="@+id/layoutPreview2x4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="12dp"
                        android:visibility="visible">

                        <LinearLayout
                            android:id="@+id/widgetConfigPreviewInput"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/attachment_widget_input_height"
                            android:background="@drawable/bg_attachment_widget_liquid_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewLogo"
                                android:layout_width="@dimen/attachment_widget_logo_size"
                                android:layout_height="@dimen/attachment_widget_logo_size"
                                android:alpha="0.72"
                                android:contentDescription="@string/app_brand"
                                android:scaleType="fitCenter"
                                android:src="@drawable/freechat_logo_white_transparent" />

                            <TextView
                                android:id="@+id/widgetConfigPreviewPlaceholder"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/main_panel_input"
                                android:textColor="#F8FBFF"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="14dp"
                            android:baselineAligned="false"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewCamera"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/button_camera"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_camera_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewGallery"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/content_desc_open_gallery"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_photo_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewDocument"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/button_files"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_file_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewMic"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/content_desc_microphone"
                                android:padding="11dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_mic"
                                android:tint="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 2x1 Layout (Single Row) -->
                    <LinearLayout
                        android:id="@+id/layoutPreview2x1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:visibility="gone">
                    </LinearLayout>

                    <!-- 2x2 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview2x2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/widgetConfigPreviewInput2x2"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_attachment_widget_liquid_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewLogo2x2"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:alpha="0.72"
                                android:contentDescription="@string/app_brand"
                                android:scaleType="fitCenter"
                                android:src="@drawable/freechat_logo_white_transparent" />

                            <TextView
                                android:id="@+id/widgetConfigPreviewPlaceholder2x2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/main_panel_input"
                                android:textColor="#F8FBFF"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewCamera2x2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/button_camera"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_camera_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewMic2x2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/content_desc_microphone"
                                android:padding="7dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_mic"
                                android:tint="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 2x3 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview2x3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/widgetConfigPreviewInput2x3"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_attachment_widget_liquid_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewLogo2x3"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:alpha="0.72"
                                android:contentDescription="@string/app_brand"
                                android:scaleType="fitCenter"
                                android:src="@drawable/freechat_logo_white_transparent" />

                            <TextView
                                android:id="@+id/widgetConfigPreviewPlaceholder2x3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/main_panel_input"
                                android:textColor="#F8FBFF"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/widgetConfigPreviewCamera2x3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/button_camera"
                                android:padding="9dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_camera_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewGallery2x3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/content_desc_open_gallery"
                                android:padding="9dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_photo_new"
                                android:tint="#FFFFFF" />

                            <ImageView
                                android:id="@+id/widgetConfigPreviewMic2x3"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_attachment_widget_liquid_button"
                                android:contentDescription="@string/content_desc_microphone"
                                android:padding="9dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_mic"
                                android:tint="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 1x1 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview1x1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">
                    </LinearLayout>

                    <!-- 1x2 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview1x2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">
                    </LinearLayout>

                    <!-- 1x3 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview1x3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">
                    </LinearLayout>

                    <!-- 1x4 Layout -->
                    <LinearLayout
                        android:id="@+id/layoutPreview1x4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="6dp"
                        android:visibility="gone">
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Widget Size Section Card -->
            <LinearLayout
                android:id="@+id/widgetSizeSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_size_section"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Row 1: 1x Column Sizes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- 1x1 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize1x1UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize1x1SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize1x1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1x1"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 1x2 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize1x2UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize1x2SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize1x2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1x2"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 1x3 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize1x3UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize1x3SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize1x3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1x3"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 1x4 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize1x4UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize1x4SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize1x4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="1x4"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2: 2x Column Sizes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- 2x1 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize2x1UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize2x1SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize2x1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="2x1"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 2x2 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize2x2UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize2x2SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize2x2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="2x2"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 2x3 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize2x3UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize2x3SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize2x3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="2x3"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- 2x4 Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">
                        <View
                            android:id="@+id/widgetSize2x4UnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />
                        <View
                            android:id="@+id/widgetSize2x4SelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />
                        <TextView
                            android:id="@+id/widgetSize2x4"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="2x4"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widgetStyleSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_config_style_section"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Liquid Glass Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/widgetStyleLiquidGlassUnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />

                        <View
                            android:id="@+id/widgetStyleLiquidGlassSelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />

                        <TextView
                            android:id="@+id/widgetStyleLiquidGlass"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/widget_style_liquid_glass"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Dark Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/widgetStyleDarkUnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />

                        <View
                            android:id="@+id/widgetStyleDarkSelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />

                        <TextView
                            android:id="@+id/widgetStyleDark"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/widget_style_dark"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Adaptive Option Frame -->
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/widgetStyleAdaptiveUnselectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_unselected" />

                        <View
                            android:id="@+id/widgetStyleAdaptiveSelectedBg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_widget_option_selected"
                            android:alpha="0.0" />

                        <TextView
                            android:id="@+id/widgetStyleAdaptive"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="@string/widget_style_adaptive"
                            android:textColor="#A8B1BE"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Transparency Slider Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <include layout="@layout/widget_config_slider_transparency" />
            </LinearLayout>

            <!-- Corner Radius Slider Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_widget_config_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <include layout="@layout/widget_config_slider_corner_radius" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
