<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_about_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_about_sheet_handle" />

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_assistant_icon">

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_brain"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvSmartNotificationsOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/smart_notifications_onboarding_title"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSmartNotificationsOnboardingDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/smart_notifications_onboarding_desc"
        android:textColor="#A8A8A8"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSmartNotificationsApiKeyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/smart_notifications_api_key_label"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etSmartNotificationsApiKey"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_capsule_bg"
        android:hint="@string/smart_notifications_api_key_hint"
        android:inputType="textPassword|textNoSuggestions"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#7A7A7E"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvSmartNotificationsApiKeySavedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/smart_notifications_api_key_saved_hint"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnSmartNotificationsAllowAccess"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_ok_white_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/smart_notifications_allow_access"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
