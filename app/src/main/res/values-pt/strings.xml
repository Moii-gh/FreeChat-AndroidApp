    <string name="security_faq_data_protection_answer">Protegemos os dados em vários níveis: limitamos o acesso apenas às partes necessárias do sistema, usamos as funcionalidades de segurança locais do Android e não mostramos detalhes sensíveis a outros utilizadores.</string>
    <string name="security_faq_data_storage_answer">As definições da app e as preferências de segurança locais são armazenadas no teu dispositivo. As funcionalidades de conta e chat podem usar o serviço da app apenas onde é necessário para o seu funcionamento.</string>
    <string name="security_faq_data_storage_title">Onde são armazenados os teus dados?</string>
    <string name="security_faq_safe_password_ai_question">Como posso criar uma palavra-passe segura para o FreeChat?</string>
    <string name="security_faq_safe_password_answer">Usa uma palavra-passe longa e única que não seja reutilizada noutros serviços. Mistura letras e números e evita nomes, datas de nascimento e sequências simples.</string>
    <string name="security_faq_safe_password_title">Como torno a minha palavra-passe segura?</string>
    <string name="security_faq_telegram_answer">O início de sessão com Telegram é usado como um passo conveniente de autorização. Ajuda a confirmar que a conta te pertence sem ecrãs de início de sessão adicionais.</string>
