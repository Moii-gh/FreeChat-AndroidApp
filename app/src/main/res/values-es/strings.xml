    <string name="security_faq_data_protection_answer">Protegemos los datos en varios niveles: limitamos el acceso solo a las partes necesarias del sistema, usamos las funciones de seguridad locales de Android y no mostramos detalles sensibles a otros usuarios.</string>
    <string name="security_faq_data_storage_answer">Los ajustes de la app y las preferencias de seguridad locales se almacenan en tu dispositivo. Las funciones de cuenta y chat pueden usar el servicio de la app solo donde sea necesario para su funcionamiento.</string>
    <string name="security_faq_data_storage_title">¿Dónde se almacenan tus datos?</string>
    <string name="security_faq_safe_password_ai_question">¿Cómo puedo crear una contraseña segura para FreeChat?</string>
    <string name="security_faq_safe_password_answer">Usa una contraseña larga y única que no se repita en otros servicios. Mezcla letras y números, y evita nombres, fechas de nacimiento y secuencias simples.</string>
    <string name="security_faq_safe_password_title">¿Cómo hago mi contraseña segura?</string>
    <string name="security_faq_telegram_answer">El inicio de sesión con Telegram se usa como un paso conveniente de autorización. Ayuda a confirmar que la cuenta te pertenece sin pantallas de inicio de sesión adicionales.</string>
